ARG NODE_VERSION=18.19.0

FROM node:${NODE_VERSION}-alpine3.17 AS node
FROM mcr.microsoft.com/powershell:lts-alpine-3.17

COPY --from=node /usr/lib /usr/lib
COPY --from=node /usr/local/lib /usr/local/lib
COPY --from=node /usr/local/include /usr/local/include
COPY --from=node /usr/local/bin /usr/local/bin

# management tools
# RUN npm i -g @pnp/cli-microsoft365 --unsafe-perm true --force
# RUN pwsh -c "Install-Module -Name Az.Accounts -RequiredVersion 2.12.5 -Scope AllUsers -Force"
RUN pwsh -c "Install-Module -Name PnP.PowerShell -Scope AllUsers -Force"
# Azure CLI
RUN apk add --no-cache -q --virtual=build gcc python3-dev musl-dev linux-headers libffi-dev openssl-dev cargo make \
     && apk add openssl python3 py3-pip \
     && pip install --no-cache-dir --testfer-binary azure-cli -q \
     && apk del --purge build

RUN mkdir /workspace

# Azure DevOps specific
RUN apk add --no-cache --virtual .pipeline-deps readline linux-pam \
  && apk add bash sudo shadow  \
  && apk del .pipeline-deps
LABEL "com.azure.dev.pipelines.agent.handler.node.path"="/usr/local/bin/node"
CMD [ "node" ]

